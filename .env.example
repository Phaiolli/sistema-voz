# voz. — environment variables
#
# IMPORTANT: keep every comment on its OWN line. Inline comments after a value
# (e.g. `KEY=value # note`) break the Supabase CLI .env parser used by
# `supabase db push` / `db:types`. See issue #53.

# ─── Supabase / Postgres ────────────────────────────────────────
# Dashboard -> Settings -> Database -> Connection string -> Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Auth (Clerk) ───────────────────────────────────────────────
# NEXT_PUBLIC_ is inlined at BUILD time — changing it on Vercel requires a redeploy.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# ─── Billing (Stripe) ───────────────────────────────────────────
# Use a restricted key in production (voz-backend).
STRIPE_SECRET_KEY=sk_test_...
# Signing secret of the /api/stripe/webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_...
# Return URL after the Customer Portal session.
STRIPE_PORTAL_RETURN_URL=https://useavoz.app/conta

# ─── Rate limiting (Upstash Redis) ──────────────────────────────
# Required in production: without these the limiter falls back to per-instance
# in-memory counters and is NOT effective across serverless instances (ADR-011).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Error monitoring (Sentry) ──────────────────────────────────
# Optional locally; set in production. Sentry is only enabled when the DSN is set.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─── Transactional e-mail (Resend) ──────────────────────────────
# Optional: e-mails are only sent when the API key is set.
RESEND_API_KEY=
# Verified sender address (SPF/DKIM/DMARC configured on the domain).
EMAIL_FROM=voz. <no-reply@useavoz.app>

# ─── Product analytics ──────────────────────────────────────────
# Enables @vercel/analytics only after cookie consent.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# ─── Seed / cron protection ─────────────────────────────────────
# Any random string — required to call POST /api/seed
SEED_SECRET=
# Bearer secret for the LGPD cleanup cron (GET /api/v1/internal/cleanup)
CRON_SECRET=

# ─── App ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://useavoz.app
